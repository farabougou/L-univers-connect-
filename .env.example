# Copier ce fichier en `.env` et adapter les valeurs pour l'environnement local.
# Ne jamais commiter le fichier `.env` lui-même (voir .gitignore).

ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# Base de données PostgreSQL locale (voir infra/docker-compose.yml).
DATABASE_URL=postgresql+psycopg://paios:paios_dev_password@localhost:5432/paios

# Fournisseur d'authentification OpenID Connect, Keycloak en local (voir
# infra/docker-compose.yml et docs/adr/002).
OIDC_ISSUER=http://localhost:8080/realms/paios
OIDC_AUDIENCE=paios-api
