# Variables de l'environnement Railway "staging" pour apps/web. Copier ces
# noms de variable dans Railway, jamais ce fichier — voir
# infra/RAILWAY_STAGING.md. Adresses de staging uniquement, jamais celles de
# développement local ni d'une future production.

OIDC_ISSUER=https://__KEYCLOAK_STAGING_DOMAIN__/realms/paios
OIDC_CLIENT_ID=paios-api
API_URL=https://__API_STAGING_DOMAIN__
APP_URL=https://__WEB_STAGING_DOMAIN__
