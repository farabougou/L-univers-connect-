# Pour tester l'application mobile contre le staging (via Expo Go ou une
# "development build"), copier ces valeurs dans un fichier `.env` local
# (jamais commité) avec les vraies adresses de staging — voir
# infra/RAILWAY_STAGING.md. Ces valeurs sont intégrées à l'application au
# moment de sa construction (voir src/lib/config.ts) : refaire tourner
# `expo start` après modification.

EXPO_PUBLIC_OIDC_ISSUER=https://__KEYCLOAK_STAGING_DOMAIN__/realms/paios
EXPO_PUBLIC_OIDC_CLIENT_ID=paios-api
EXPO_PUBLIC_API_URL=https://__API_STAGING_DOMAIN__
