# Copier ce fichier en `.env` et adapter les valeurs. Ne jamais commiter `.env`.
#
# Depuis un téléphone physique (via Expo Go), "localhost" désigne le téléphone
# lui-même, pas l'ordinateur qui fait tourner Keycloak et l'API. Remplacer par
# l'adresse IP de l'ordinateur sur le réseau local (ex: 192.168.1.42), trouvable
# avec `ipconfig` (Windows) ou `ifconfig`/`ip a` (Mac/Linux). Le téléphone et
# l'ordinateur doivent être sur le même réseau Wi-Fi.

EXPO_PUBLIC_OIDC_ISSUER=http://192.168.1.42:8080/realms/paios
EXPO_PUBLIC_OIDC_CLIENT_ID=paios-api
EXPO_PUBLIC_API_URL=http://192.168.1.42:8000
